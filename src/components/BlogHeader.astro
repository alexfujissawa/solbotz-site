---
interface Props {
  active?: 'home' | 'blog';
}

const { active = 'blog' } = Astro.props;
---

<header class="fixed w-full top-0 z-50 bg-[#070708]/85 backdrop-blur-xl border-b border-white/[0.06] transition-all">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Marca: Logo com tratamento dark mode -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl blur opacity-30 group-hover:opacity-75 transition duration-300"></div>
        <img 
          src="/solbotz.jpeg" 
          alt="SolBotz Logo" 
          class="relative h-10 w-10 rounded-xl object-cover border border-white/10 shadow-md group-hover:scale-105 transition-transform duration-300" 
        />
      </div>
      <span class="font-bold text-2xl tracking-tight text-white flex items-center">
        solbotz<span class="text-blue-500">.</span>
      </span>
    </a>

    <!-- Navegação Central -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="/" class={`transition-colors duration-200 ${active === 'home' ? 'text-white font-semibold' : 'text-gray-400 hover:text-white'}`}>
        Home
      </a>
      <a href="/#gargalos" class="text-gray-400 hover:text-white transition-colors duration-200">
        Gargalos
      </a>
      <a href="/#solucao" class="text-gray-400 hover:text-white transition-colors duration-200">
        Solução
      </a>
      <a href="/#metodologia" class="text-gray-400 hover:text-white transition-colors duration-200">
        Metodologia
      </a>
      <a href="/blog" class={`transition-colors duration-200 flex items-center gap-1.5 ${active === 'blog' ? 'text-blue-400 font-semibold' : 'text-gray-400 hover:text-white'}`}>
        <span>Blog</span>
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
      </a>
    </nav>

    <!-- Ações do Topo: CTA -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a 
        href="/#contato" 
        class="relative inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider text-black bg-white hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(255,255,255,0.25)] hover:shadow-[0_0_35px_rgba(255,255,255,0.4)]"
      >
        <span class="hidden sm:inline">Solicitar Diagnóstico</span>
        <span class="sm:hidden">Diagnóstico</span>
      </a>
    </div>
  </div>
</header>
