---
import Layout from '../layouts/Layout.astro';
import HeroMockup from '../components/HeroMockup';
import PainSection from '../components/PainSection';
import StrategicValueSection from '../components/StrategicValueSection';
import MethodologySection from '../components/MethodologySection';
import DifferentiatorsSection from '../components/DifferentiatorsSection';
import ContactForm from '../components/ContactForm';
import PartnersDropdown from '../components/PartnersDropdown';
---

<Layout title="SolBotz | Consultoria em Eficiência Operacional & Automação Inteligente">
  <!-- 1. Navbar Minimalista Apple Style -->
  <header class="fixed w-full top-0 z-50 bg-[#070708]/75 backdrop-blur-xl border-b border-white/[0.06] transition-all">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <!-- Marca: Logo com tratamento dark mode -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="relative">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl blur opacity-30 group-hover:opacity-75 transition duration-300"></div>
          <img 
            src="/solbotz.jpeg" 
            alt="SolBotz Logo" 
            class="relative h-10 w-10 rounded-xl object-cover border border-white/10 shadow-md group-hover:scale-105 transition-transform duration-300" 
          />
        </div>
        <span class="font-bold text-2xl tracking-tight text-white flex items-center">
          solbotz<span class="text-blue-500">.</span>
        </span>
      </a>

      <!-- Navegação Central -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
        <a href="#gargalos" class="hover:text-white transition-colors duration-200">Gargalos</a>
        <a href="#solucao" class="hover:text-white transition-colors duration-200">Valor Estratégico</a>
        <a href="#metodologia" class="hover:text-white transition-colors duration-200">Metodologia</a>
        <a href="#diferencial" class="hover:text-white transition-colors duration-200">Diferencial</a>
        <a href="/blog" class="hover:text-blue-400 transition-colors duration-200 flex items-center gap-1.5">
          <span>Blog</span>
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        </a>
      </nav>

      <!-- Ações do Topo: Parceiros & CTA -->
      <div class="flex items-center gap-3 sm:gap-4">
        <PartnersDropdown client:load />

        <a 
          href="#contato" 
          class="relative inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider text-black bg-white hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(255,255,255,0.25)] hover:shadow-[0_0_35px_rgba(255,255,255,0.4)]"
        >
          <span class="hidden sm:inline">Solicitar Diagnóstico Operacional</span>
          <span class="sm:hidden">Diagnóstico</span>
        </a>
      </div>
    </div>
  </header>

  <main class="relative z-10">
    <!-- Seção 1: O "Hero" (Primeira Tela - Acima da dobra) -->
    <section class="min-h-screen flex flex-col items-center justify-center text-center px-4 pt-32 pb-24 relative overflow-hidden">
      <!-- Ambient Flare Behind Hero -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[750px] h-[380px] bg-blue-600/15 blur-[130px] rounded-full pointer-events-none"></div>

      <!-- Subtítulo (Eyebrow): CONSULTORIA EM EFICIÊNCIA OPERACIONAL -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase text-blue-300 bg-blue-500/10 border border-blue-500/20 mb-8 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span>CONSULTORIA EM EFICIÊNCIA OPERACIONAL</span>
      </div>

      <!-- Headline Principal -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight max-w-5xl bg-clip-text text-transparent bg-gradient-to-b from-white via-white to-gray-400 mb-8 leading-[1.08]">
        Soluções em engenharia de automação e IA para escalar sua operação com máxima eficiência.
      </h1>

      <!-- Sub-Headline -->
      <p class="text-base sm:text-lg md:text-xl text-gray-400 max-w-3xl mb-12 font-light leading-relaxed">
        Projetamos infraestruturas autônomas que eliminam o trabalho manual da sua equipe, aceleram o tempo de resposta aos clientes e protegem a sua rentabilidade. Tecnologia corporativa, aplicada à realidade do seu negócio.
      </p>

      <!-- Botões de Ação -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mb-8">
        <a 
          href="#contato" 
          class="w-full sm:w-auto relative group inline-flex items-center justify-center px-8 py-4 rounded-full font-medium text-white bg-blue-600 hover:bg-blue-500 transition-all duration-300 shadow-[0_0_40px_rgba(37,99,235,0.35)] hover:shadow-[0_0_65px_rgba(37,99,235,0.6)] hover:scale-105"
        >
          <span>Solicitar Diagnóstico Operacional</span>
          <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a 
          href="#metodologia" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-full font-medium text-sm text-gray-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 backdrop-blur-md transition-all duration-300"
        >
          Conhecer a Metodologia
        </a>
      </div>

      <!-- Métricas Rápidas Apple Style -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-mono text-gray-500 mt-4 mb-2">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>99.9% SLA & Disponibilidade</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span>Resposta Imediata aos Clientes</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
          <span>Infraestrutura Corporativa Segura</span>
        </div>
      </div>

      <!-- Mockup do Processo Operacional / Executivo -->
      <HeroMockup client:load />
    </section>

    <!-- Seção 2: A Agitação da Dor (Foco no Prejuízo Invisível) -->
    <section id="gargalos" class="py-32 px-6 max-w-7xl mx-auto relative">
      <PainSection client:visible />
    </section>

    <!-- Seção 3: A Solução (O Valor Estratégico) -->
    <section id="solucao" class="py-32 px-6 max-w-7xl mx-auto relative">
      <div class="absolute inset-0 bg-white/[0.015] rounded-3xl border border-white/[0.06] -z-10 pointer-events-none backdrop-blur-3xl"></div>
      <StrategicValueSection client:visible />
    </section>

    <!-- Seção 4: A Metodologia (O Processo Consultivo) -->
    <section id="metodologia" class="py-32 px-6 max-w-7xl mx-auto relative">
      <MethodologySection client:visible />
    </section>

    <!-- Seção 5: Diferencial (Por que a SolBotz) -->
    <section id="diferencial" class="py-32 px-6 max-w-7xl mx-auto relative">
      <div class="absolute inset-0 bg-white/[0.015] rounded-3xl border border-white/[0.06] -z-10 pointer-events-none backdrop-blur-3xl"></div>
      <DifferentiatorsSection client:visible />
    </section>

    <!-- Seção 6: O Fechamento (Rodapé & Formulário de Diagnóstico) -->
    <section id="contato" class="py-32 px-6 max-w-7xl mx-auto text-center relative">
      <div class="max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-4">
          Diagnóstico Estratégico
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-6">
          Vamos calcular o impacto da <br class="hidden sm:inline" />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-300">
            automação no seu negócio?
          </span>
        </h2>
        <p class="text-base sm:text-lg text-gray-400 font-light max-w-2xl mx-auto">
          Agende uma sessão de diagnóstico estratégico. Faremos um mapeamento rápido dos seus processos atuais e desenharemos um plano de ação para escalar a sua operação com eficiência.
        </p>
      </div>

      <!-- Formulário com Caixa Suspensa de Qualificação Exata da Copy -->
      <ContactForm client:visible />
    </section>
  </main>

  <!-- Rodapé Minimalista -->
  <footer class="border-t border-white/5 py-16 px-6 bg-[#050507]">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
      <div class="flex items-center gap-3">
        <img 
          src="/solbotz.jpeg" 
          alt="SolBotz Logo" 
          class="h-8 w-8 rounded-lg object-cover border border-white/10" 
        />
        <span class="font-bold text-lg tracking-tight text-white">
          solbotz<span class="text-blue-500">.</span>
        </span>
        <span class="text-xs text-gray-500 border-l border-white/10 pl-3">
          Consultoria em Eficiência Operacional & Automação Inteligente
        </span>
      </div>

      <div class="flex items-center gap-6 text-xs text-gray-400">
        <a href="#gargalos" class="hover:text-white transition-colors">Gargalos</a>
        <a href="#solucao" class="hover:text-white transition-colors">Solução</a>
        <a href="#metodologia" class="hover:text-white transition-colors">Metodologia</a>
        <a href="#diferencial" class="hover:text-white transition-colors">Diferencial</a>
        <a href="/blog" class="hover:text-white text-blue-400 transition-colors">Blog</a>
        <a href="#contato" class="hover:text-white transition-colors">Diagnóstico</a>
      </div>

      <div class="text-xs text-gray-500">
        © {new Date().getFullYear()} SolBotz. Todos os direitos reservados.
      </div>
    </div>
  </footer>
</Layout>
