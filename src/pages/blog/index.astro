---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import BlogFooter from '../../components/BlogFooter.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter(p => p.id !== featuredPost?.id);

// Categorias únicas
const categories = Array.from(new Set(allPosts.map(p => p.data.category)));
---

<Layout 
  title="Blog SolBotz | Automação Inteligente, Agentes de IA e Eficiência Operacional"
  description="Artigos estratégicos, estudos de caso e tutoriais práticos para líderes e empresas que desejam escalar operações eliminando desperdício e gargalos."
>
  <BlogHeader active="blog" />

  <main class="relative z-10 pt-32 pb-16 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Hero do Blog -->
      <header class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase text-blue-300 bg-blue-500/10 border border-blue-500/20 mb-6 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span>INSIGHTS & ENGENHARIA DE PROCESSOS</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
          Blog SolBotz<span class="text-blue-500">.</span>
        </h1>

        <p class="text-base sm:text-lg text-gray-400 font-light leading-relaxed">
          Estratégias de ponta, estudos de caso e arquiteturas reais de automação e inteligência artificial para destravar o crescimento do seu negócio.
        </p>

        <!-- Filtro rápido de categorias (visual) -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-8">
          <span class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-blue-500/20 text-blue-300 border border-blue-500/30">
            Todos ({allPosts.length})
          </span>
          {categories.map((cat) => (
            <span class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.04] text-gray-400 border border-white/5 hover:border-white/20 transition-colors">
              {cat}
            </span>
          ))}
        </div>
      </header>

      <!-- Post em Destaque -->
      {featuredPost && (
        <section class="mb-14">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-400 mb-4 px-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span>Artigo em Destaque</span>
          </div>
          <BlogCard
            slug={featuredPost.id}
            title={featuredPost.data.title}
            description={featuredPost.data.description}
            pubDate={featuredPost.data.pubDate}
            category={featuredPost.data.category}
            readTime={featuredPost.data.readTime}
            tags={featuredPost.data.tags}
            featured={true}
          />
        </section>
      )}

      <!-- Grid de Posts Recentes -->
      <section>
        <div class="flex items-center justify-between mb-8 px-1">
          <h2 class="text-xl font-bold tracking-tight text-white">
            Últimas Publicações
          </h2>
          <span class="text-xs text-gray-500">
            {regularPosts.length} artigos
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {regularPosts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readTime={post.data.readTime}
              tags={post.data.tags}
              featured={false}
            />
          ))}
        </div>
      </section>

      <!-- Banner CTA Final de Diagnóstico -->
      <section class="mt-20 p-8 sm:p-12 rounded-3xl glass-panel relative overflow-hidden border border-blue-500/20 text-center">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-blue-600/20 blur-[90px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto">
          <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
            Sua operação está pronta para o próximo nível?
          </h3>
          <p class="text-sm sm:text-base text-gray-400 font-light mb-8">
            Não deixe que processos manuais e ineficiências segurem o crescimento da sua empresa. Faça uma sessão de diagnóstico operacional gratuita com nossos especialistas.
          </p>
          <a 
            href="/#contato" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full text-xs font-semibold uppercase tracking-wider text-black bg-white hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(255,255,255,0.25)]"
          >
            Solicitar Diagnóstico Operacional
          </a>
        </div>
      </section>
    </div>
  </main>

  <BlogFooter />
</Layout>
